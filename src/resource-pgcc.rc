#include <windows.h>
#include "resource.h"

//
// Version Information
//

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3, 0, 0, 0
PRODUCTVERSION  3, 0, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904b0"
    {
      VALUE "CompanyName",      "watamario15\0"
      VALUE "FileDescription",  "Prime Calculator\0"
      VALUE "FileVersion",      "3\0"
      VALUE "InternalName",     "prime\0"
      VALUE "LegalCopyright",   "(C) 2018-2026 watamario15\0"
      VALUE "OriginalFilename", "prime.exe\0"
      VALUE "ProductName",      "Prime Calculator\0"
      VALUE "ProductVersion",   "3\0"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x411, 1200, 0x409, 1200
  }
}


//
// Icon
//

ResIcon ICON "app.ico"


//
// Menu
//

ResMenu_JA MENU
{
  POPUP "ファイル (&F)"
  {
    MENUITEM "ファイルに保存 (&S)", IDM_FILE_SAVE_AS
    MENUITEM "終了 (&X)", IDM_FILE_EXIT
  }
  POPUP "編集 (&E)"
  {
    MENUITEM "切り取り (&T)", IDM_EDIT_CUT
    MENUITEM "コピー (&C)", IDM_EDIT_COPY
    MENUITEM "貼\り付け (&P)", IDM_EDIT_PASTE
    MENUITEM "全選択 (&A)", IDM_EDIT_SELECT_ALL
  }
  POPUP "オプション (&O)"
  {
    MENUITEM "素因数分解 (&F)", IDM_OPT_PF
    MENUITEM "素数列挙・数え (&E)", IDM_OPT_PE
    MENUITEM SEPARATOR
    MENUITEM "個数のみ表\示 (&N)", IDM_OPT_CNTONLY
    MENUITEM "テキストファイルに出力 (&T)", IDM_OPT_OUTFILE
    MENUITEM SEPARATOR
    POPUP "&Language"
    {
      MENUITEM "日本語 (&J)", IDM_OPT_LANG_JA
      MENUITEM "&English", IDM_OPT_LANG_EN
    }
    POPUP "文字コード (&C)"
    {
      MENUITEM "&UTF-8", IDM_OPT_CHARSET_UTF8
      MENUITEM "&Shift_JIS (CP932)", IDM_OPT_CHARSET_SJIS
    }
  }
  POPUP "ヘルプ (&H)"
  {
    MENUITEM "使い方 (&U)", IDM_HELP_HOWTOUSE
    MENUITEM "このプログラムについて (&A)", IDM_HELP_ABOUT
  }
}

ResMenu_EN MENU
{
  POPUP "&File"
  {
    MENUITEM "&Save As...", IDM_FILE_SAVE_AS
    MENUITEM "E&xit", IDM_FILE_EXIT
  }
  POPUP "&Edit"
  {
    MENUITEM "Cu&t", IDM_EDIT_CUT
    MENUITEM "&Copy", IDM_EDIT_COPY
    MENUITEM "&Paste", IDM_EDIT_PASTE
    MENUITEM "Select &All", IDM_EDIT_SELECT_ALL
  }
  POPUP "&Options"
  {
    MENUITEM "Prime &Factorization", IDM_OPT_PF
    MENUITEM "&Enumerate Prime Numbers", IDM_OPT_PE
    MENUITEM SEPARATOR
    MENUITEM "Show only &number of prime numbers", IDM_OPT_CNTONLY
    MENUITEM "Output to a &text file", IDM_OPT_OUTFILE
    MENUITEM SEPARATOR
    POPUP "&Language"
    {
      MENUITEM "日本語 (&J)", IDM_OPT_LANG_JA
      MENUITEM "&English", IDM_OPT_LANG_EN
    }
    POPUP "&Charset"
    {
      MENUITEM "&UTF-8", IDM_OPT_CHARSET_UTF8
      MENUITEM "&Shift_JIS (CP932)", IDM_OPT_CHARSET_SJIS
    }
  }
  POPUP "&Help"
  {
    MENUITEM "How to &use", IDM_HELP_HOWTOUSE
    MENUITEM "&About this software", IDM_HELP_ABOUT
  }
}


//
// Accelerators
//

ResAccel ACCELERATORS
{
  "^A", IDM_EDIT_SELECT_ALL
}


//
// String Table
//

STRINGTABLE
{
  IDS_APPNAME "Prime Calculator"
  IDS_ABOUT "Prime Calculator Ver. 3\012\012\
Performs calculations related to prime numbers, suporting natural numbers within signed 64-bit integer. This software is licensed under the MIT License."
  IDS_BUILD "Build date: "
  IDS_COPYRIGHT "(C) 2018-2026 watamario15"
  IDS_PFHELP "Enter a natural number in the input box and press the OK button or the Enter key to start a prime factorization (it can also usable as prime number deciding). As it takes time to process a number with a large prime factor, you can use the Abort button to cancel. Results and errors will be displayed on the box located at the center of the screen. You can switch to the Enumerate Prime Numbers feature in the options menu."
  IDS_PEHELP "Specify a range to enumerate prime numbers and a max count within, and press the OK button or the Enter key to start. Invalid or 0 will be taken as unlimited. As it takes time to process a large prime number, you can use the Abort button to cancel. Results and errors will be displayed on the box located at the center of the screen. You can configure outputs in the options menu. If ""Output to a text file"" is checked, this software writes the result on a specified text file instead of the screen (faster than screen). You can switch to the Prime Factorization feature in the options menu."
  IDS_OK "OK"
  IDS_ABORT "Abort"
  IDS_CLRHST "Clear History"
  IDS_BS "BS"
  IDS_CE "CE"
